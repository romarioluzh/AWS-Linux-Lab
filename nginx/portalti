server {
    server_name portalti.duckdns.org;

    root /var/www/portalti/public_html;
    index index.html;

    access_log /var/log/nginx/portalti.access.log;
    error_log /var/log/nginx/portalti.error.log;

    location / {
        try_files $uri $uri/ =404;
    }

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/portalti.duckdns.org/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/portalti.duckdns.org/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot


}
server {
    if ($host = portalti.duckdns.org) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    server_name portalti.duckdns.org;
    return 404; # managed by Certbot


}